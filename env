OML_HOSTNAME=127.0.0.1

# --- Timezone for the environment
TZ=America/Argentina/Cordoba

# --- OMniDialer images
API_IMG=dialer_api:latest
LISTENER_IMG=dialer_listener:latest
WORKER_IMG=dialer_worker:latest
SCHEDULER_IMG=dialer_scheduler:latest
DIALPLAN_IMG=dialer_dialplan:latest
ASTERISK_IMG=dialer:latest

POSTGRES_IMG=docker.io/library/postgres:14.9-bullseye



####################### --- OML conn params ---- ########################

# --- Redis OML conn params
REDIS_HOSTNAME=redis
REDIS_PORT=6379

# --- Gearman conn params
GEARMAN_HOSTNAME=gearman
GEARMAN_PORT=4730

# --- Postgres OML conn params
PGHOST=postgresql

PGDATABASE=omnileads
PGPORT=5432
PGUSER=omnileads
PGPASSWORD=admin123

# --- AST conn params
AMI_USER=omnileadsami
AMI_PASSWORD=5_MeO_DMT

# --- Only used on test-env or dev-env to test the dialer
DIALER_ASTERISK_IPV4=10.55.22.199

# --- IP or hostname that each instance will invoke when locating the other
# When omnidialer run in other host, you must set the OMNIDIALER_HOST variable with
# the IP or hostname of the host
OMNIDIALER_HOST=dialer-api:1440
# --- Scheduler API connection params
SCHEDULER_API_HOST=scheduler-api:1441

# --- Dialer API connection params
DIALER_API_EXT_BIND_IP=${OML_HOSTNAME}
DIALER_API_EXT_PORT=1440
DIALER_SCHEDULER_EXT_BIND_IP=${OML_HOSTNAME}
DIALER_SCHEDULER_EXT_PORT=1441


# --- Asterisk dialer container params
# --- On test-env or dev-env you must set the ASTERISK_DIALER_HOSTNAME variable with "dialer-asterisk" string
ASTERISK_DIALER_HOSTNAME=dialer-acd
ASTERISK_DIALER_ARI_PORT=8888
ASTERISK_APP_DIALER=call_manager_dialer

# --- Redis OML & dialer conn params
REDIS_DIALER_SERVER=${REDIS_HOSTNAME}
REDIS_DIALER_PORT=${REDIS_PORT}
REDIS_DIALER_DB=3

# --- OML Websocket channel path (adjust if OML is running in other host)
WEBSOCKET_SERVER=wss://${OML_HOSTNAME}/channels/omnidialer/0mn1d14l3r

# --- Postgres dialer conn params
POSTGRES_DIALER_USER=omnidialer
POSTGRES_DIALER_PASSWORD=dialer456
POSTGRES_DIALER_SERVER=dialer-postgresql
POSTGRES_DIALER_PORT=5433
POSTGRES_DIALER_DB=omnidialer

# --- Gearman conn params
GEARMAN_JOB_SERVERS=${GEARMAN_HOSTNAME}:${GEARMAN_PORT}
GEARMAN_JOBS=start-campaign|stop-campaign|resume-campaign|process-contact|schedule-contact|process-event|create-campaign|edit-campaign|pause-campaign|delete-campaign|send-reports|add-incidence-rule-disposition|create-incidence-rule|process-campaign|delete-incidence-rule|update-incidence-rule|schedule-agenda|change-database|render-template|manage-dialer

# --- Log level
PYTHON_LOGLEVEL=debug

# --- OMniLeads ACD SIP Peer when dialer send calls
# --- On test-env or dev-env you must set the 127.0.0.1:5260 with "acd:5260" string
OMLACD_SIP_SERVER=acd:5260

# --- Call attempts per second
DIALER_CAPS=1

# --- Workers replicas
PROCESS_CAMPAIGN_REPLICAS=1
PROCESS_CONTACT_REPLICAS=1
PROCESS_EVENT_REPLICAS=1
LISTENER_REPLICAS=1

# --- Dial through PSTN Gateway settings
# --- In order to use this feature, you must have a PSTN Gateway configured
# --- with SIP registration and authentication enabled.
# PSTNGW_REGISTER=yes
# PSTNGW_SIP_AUTH=yes
# PSTNGW_SIP_USER=01177660010
# PSTNGW_SIP_PASS=omnileads
# PSTNGW_HOSTNAME=pbxemulator:5070

NETWORK=dev-env_omnileads

# --- Time between the iterations when there are no contacts to call (in seconds)
TIME_BETWEEN_CALLS=1